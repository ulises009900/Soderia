# .env.example (sin secretos reales)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# Alternativa (si no usas DATABASE_URL):
# PGHOST=<host>
# PGPORT=5432
# PGDATABASE=<database>
# PGUSER=<user>
# PGPASSWORD=<password>
SESSION_SECRET=change-this-to-a-long-random-secret
PORT=3000
NODE_ENV=development

