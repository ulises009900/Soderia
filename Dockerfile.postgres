# Production Dockerfile para Render con PostgreSQL
FROM node:18-alpine

WORKDIR /app

# Copiar archivos
COPY package*.json ./
COPY db-config.js ./
COPY init-postgres.js ./
COPY server-postgres.js ./server.js
COPY public/ ./public/
COPY views/ ./views/

# Instalar dependencias
RUN npm install --production

# Inicializar BD (ejecutado automáticamente)
CMD ["sh", "-c", "node init-postgres.js && node server.js"]
